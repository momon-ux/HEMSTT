/** HEMSTT — pelayan pusat multi-sekolah. Rahsia disimpan dalam Script Properties. */
const HEMSTT=Object.freeze({version:"2.0.0",schema:"2",modules:["attendance","weekly-duty","staff-presence","school-monitoring","rmt","documents"],sheets:{
schools:["id","code","name","district","state","address","logoUrl","sessionMode","morningName","afternoonName","status","createdAt","updatedAt"],
admins:["id","schoolId","fullName","username","passwordSalt","passwordHash","mustChangePassword","active","createdAt","updatedAt"],
teachers:["id","schoolId","fullName","staffId","username","passwordSalt","passwordHash","mustChangePassword","active","sessionName","className","roles","createdAt","updatedAt"],
records:["id","schoolId","teacherId","module","recordDate","sessionName","status","title","summary","numericValue","details","createdAt","updatedAt"],
sessions:["id","tokenHash","role","adminId","schoolId","expiresAt","createdAt"],audit:["id","actorRole","actorAdminId","schoolId","action","details","createdAt"]},sessionHours:12});
let DB_CACHE_=null,SHEET_CACHE_={};

function doGet(e){try{const p=(e&&e.parameter)||{};return output_(route_(String(p.action||"me"),p,"GET"));}catch(x){return output_({ok:false,error:safeError_(x)});}}
function doPost(e){try{const b=JSON.parse((e&&e.postData&&e.postData.contents)||"{}");return output_(route_(String(b.action||""),b,"POST"));}catch(x){return output_({ok:false,error:safeError_(x)});}}
function route_(a,d,m){ensureSchema_();if(m==="POST"&&a==="superLogin")return superLogin_(d);if(m==="POST"&&a==="schoolLogin")return login_("admins","school",d);if(m==="POST"&&a==="teacherLogin")return login_("teachers","teacher",d);const s=requireSession_(d.token);if(a==="me")return me_(s);if(a==="logout")return logout_(s);if(a==="schools")return requireSuper_(s)&&{ok:true,schools:schoolList_()};if(a==="createSchool")return createSchool_(requireSuper_(s),d);if(a==="resetAdminPassword")return resetAdminPassword_(requireSuper_(s),d);if(a==="updateSchool")return updateSchool_(s,d);if(a==="changePassword")return changePassword_(s,d);if(a==="teachers")return {ok:true,teachers:teacherList_(requireSchool_(s).schoolId)};if(a==="createTeacher")return createTeacher_(requireSchool_(s),d);if(a==="updateTeacher")return updateTeacher_(requireSchool_(s),d);if(a==="resetTeacherPassword")return resetTeacherPassword_(requireSchool_(s),d);if(a==="dashboardData")return dashboardData_(s);if(a==="records")return recordList_(s,d);if(a==="saveRecord")return saveRecord_(s,d);throw new Error("Tindakan tidak dibenarkan.");}

function setupHemstt(){const p=PropertiesService.getScriptProperties();if(!p.getProperty("SUPER_ADMIN_CODE")||!p.getProperty("TEMP_SCHOOL_PASSWORD"))throw new Error("Tetapan keselamatan belum lengkap.");if(!p.getProperty("PASSWORD_PEPPER"))p.setProperty("PASSWORD_PEPPER",random_(48));let id=p.getProperty("DATABASE_SPREADSHEET_ID"),ss;if(id)ss=SpreadsheetApp.openById(id);else{ss=SpreadsheetApp.create("HEMSTT — Pangkalan Data Induk");id=ss.getId();p.setProperty("DATABASE_SPREADSHEET_ID",id);}Object.keys(HEMSTT.sheets).forEach(n=>ensureSheet_(ss,n,HEMSTT.sheets[n]));const first=ss.getSheetByName("Sheet1");if(first&&ss.getSheets().length>1)ss.deleteSheet(first);if(!p.getProperty("LOGO_FOLDER_ID")){const f=DriveApp.createFolder("HEMSTT — Logo Sekolah");p.setProperty("LOGO_FOLDER_ID",f.getId());}p.setProperty("SCHEMA_VERSION",HEMSTT.schema);return {ok:true,spreadsheetId:id,spreadsheetUrl:ss.getUrl()};}
function configureSecurity(code,password){if(!code||String(code).length<8||!password||String(password).length<8)throw new Error("Kod keselamatan terlalu pendek.");PropertiesService.getScriptProperties().setProperties({SUPER_ADMIN_CODE:String(code),TEMP_SCHOOL_PASSWORD:String(password)},false);return "Tetapan keselamatan disimpan.";}
function ensureSchema_(){const p=PropertiesService.getScriptProperties();if(p.getProperty("SCHEMA_VERSION")===HEMSTT.schema)return;const l=LockService.getScriptLock();l.waitLock(20000);try{if(p.getProperty("SCHEMA_VERSION")!==HEMSTT.schema){Object.keys(HEMSTT.sheets).forEach(n=>ensureSheet_(db_(),n,HEMSTT.sheets[n]));p.setProperty("SCHEMA_VERSION",HEMSTT.schema);}}finally{l.releaseLock();}}

function superLogin_(d){throttle_("super:"+clean_(d.clientKey,80));if(!secureEqual_(clean_(d.code,100),property_("SUPER_ADMIN_CODE")))throw new Error("Kod Pentadbir Utama tidak sah.");return {ok:true,token:createSession_("super","",""),role:"super"};}
function login_(sheetName,role,d){const u=clean_(d.username,80).toLowerCase();throttle_(role+":"+u);const user=rows_(sheetName).find(r=>String(r.username).toLowerCase()===u);if(!user||!truthy_(user.active)||!secureEqual_(passwordHash_(clean_(d.password,150),user.passwordSalt),user.passwordHash))throw new Error(role==="teacher"?"ID guru atau kata laluan tidak sah.":"ID pentadbir atau kata laluan tidak sah.");const school=byId_("schools",user.schoolId);if(!school||school.status!=="active")throw new Error("Akaun sekolah tidak aktif.");return {ok:true,token:createSession_(role,user.id,user.schoolId),role:role,mustChangePassword:truthy_(user.mustChangePassword)};}
function me_(s){if(s.role==="super")return {ok:true,role:"super",name:"Pentadbir Utama HEMSTT"};const school=byId_("schools",s.schoolId);if(!school)throw new Error("Sekolah tidak dijumpai.");if(s.role==="school"){const a=byId_("admins",s.adminId);if(!a)throw new Error("Akaun tidak dijumpai.");return {ok:true,role:"school",admin:publicAdmin_(a),school:publicSchool_(school)};}const t=byId_("teachers",s.adminId);if(!t)throw new Error("Akaun guru tidak dijumpai.");return {ok:true,role:"teacher",teacher:publicTeacher_(t),school:publicSchool_(school)};}
function logout_(s){deleteById_("sessions",s.id);return {ok:true};}

function createSchool_(s,d){return withLock_(()=>{const code=clean_(d.code,20).toUpperCase().replace(/[^A-Z0-9-]/g,""),name=clean_(d.name,150),adminName=clean_(d.adminName,150);if(!code||!name||!adminName)throw new Error("Kod, nama sekolah dan nama pentadbir diperlukan.");const ss=sheet_("schools"),as=sheet_("admins");if(rowsFrom_(ss,"schools").some(r=>String(r.code).toUpperCase()===code))throw new Error("Kod sekolah ini sudah didaftarkan.");const now=new Date().toISOString(),schoolId=Utilities.getUuid(),adminId=Utilities.getUuid(),username="admin."+code.toLowerCase(),password=property_("TEMP_SCHOOL_PASSWORD"),salt=random_(32);appendTo_(ss,"schools",{id:schoolId,code:code,name:name,district:clean_(d.district,80)||"Tawau",state:clean_(d.state,80)||"Sabah",address:clean_(d.address,400),logoUrl:"",sessionMode:d.sessionMode==="two"?"two":"one",morningName:clean_(d.morningName,60)||"Sidang Pagi",afternoonName:d.sessionMode==="two"?(clean_(d.afternoonName,60)||"Sidang Petang"):"",status:"active",createdAt:now,updatedAt:now});appendTo_(as,"admins",{id:adminId,schoolId:schoolId,fullName:adminName,username:username,passwordSalt:salt,passwordHash:passwordHash_(password,salt),mustChangePassword:true,active:true,createdAt:now,updatedAt:now});audit_(s,"school_created",schoolId,code);return {ok:true,schoolId:schoolId,schoolName:name,username:username,temporaryPassword:password};});}
function resetAdminPassword_(s,d){return withLock_(()=>{const schoolId=clean_(d.schoolId,80),a=rows_("admins").find(r=>r.schoolId===schoolId),school=byId_("schools",schoolId);if(!a||!school)throw new Error("Pentadbir sekolah tidak dijumpai.");const salt=random_(32),password=property_("TEMP_SCHOOL_PASSWORD");updateById_("admins",a.id,{passwordSalt:salt,passwordHash:passwordHash_(password,salt),mustChangePassword:true,updatedAt:new Date().toISOString()});audit_(s,"admin_password_reset",schoolId,a.username);return {ok:true,schoolName:school.name,username:a.username,temporaryPassword:password};});}
function updateSchool_(s,d){return withLock_(()=>{const id=s.role==="super"?clean_(d.schoolId,80):s.schoolId,school=byId_("schools",id);if(!school)throw new Error("Sekolah tidak dijumpai.");const mode=d.sessionMode==="two"?"two":"one",patch={name:clean_(d.name,150)||school.name,district:clean_(d.district,80)||school.district,state:clean_(d.state,80)||school.state,address:clean_(d.address,400),sessionMode:mode,morningName:clean_(d.morningName,60)||"Sidang Pagi",afternoonName:mode==="two"?(clean_(d.afternoonName,60)||"Sidang Petang"):"",updatedAt:new Date().toISOString()};if(d.logoData)patch.logoUrl=saveLogo_(school,d.logoData);updateById_("schools",id,patch);return {ok:true,school:publicSchool_(Object.assign({},school,patch))};});}

function teacherList_(schoolId){return rows_("teachers").filter(r=>r.schoolId===schoolId).map(publicTeacher_).sort((a,b)=>a.fullName.localeCompare(b.fullName));}
function createTeacher_(s,d){return withLock_(()=>{const name=clean_(d.fullName,150),staff=clean_(d.staffId,40),roles=validRoles_(d.roles);if(!name||!roles.length)throw new Error("Nama guru dan sekurang-kurangnya satu tugasan diperlukan.");const school=byId_("schools",s.schoolId),all=rows_("teachers");let base=(staff||name.split(/\s+/).slice(0,2).join(".")).toLowerCase().replace(/[^a-z0-9.]/g,"").replace(/\.+/g,".")||"guru",username=base+"."+String(school.code).toLowerCase(),n=2;while(all.some(r=>String(r.username).toLowerCase()===username))username=base+n+++"."+String(school.code).toLowerCase();const password="Hm"+random_(6)+"!",salt=random_(32),now=new Date().toISOString(),id=Utilities.getUuid();append_("teachers",{id:id,schoolId:s.schoolId,fullName:name,staffId:staff,username:username,passwordSalt:salt,passwordHash:passwordHash_(password,salt),mustChangePassword:true,active:true,sessionName:clean_(d.sessionName,60),className:clean_(d.className,60),roles:roles.join(","),createdAt:now,updatedAt:now});audit_(s,"teacher_created",s.schoolId,username);return {ok:true,teacher:publicTeacher_(byId_("teachers",id)),username:username,temporaryPassword:password,schoolName:school.name};});}
function updateTeacher_(s,d){return withLock_(()=>{const t=byId_("teachers",clean_(d.teacherId,80)),roles=validRoles_(d.roles);if(!t||t.schoolId!==s.schoolId)throw new Error("Guru tidak dijumpai.");if(!roles.length)throw new Error("Pilih sekurang-kurangnya satu tugasan.");const patch={fullName:clean_(d.fullName,150)||t.fullName,staffId:clean_(d.staffId,40),sessionName:clean_(d.sessionName,60),className:clean_(d.className,60),roles:roles.join(","),active:d.active===false||d.active==="false"?false:true,updatedAt:new Date().toISOString()};updateById_("teachers",t.id,patch);return {ok:true,teacher:publicTeacher_(Object.assign({},t,patch))};});}
function resetTeacherPassword_(s,d){return withLock_(()=>{const t=byId_("teachers",clean_(d.teacherId,80));if(!t||t.schoolId!==s.schoolId)throw new Error("Guru tidak dijumpai.");const password="Hm"+random_(6)+"!",salt=random_(32);updateById_("teachers",t.id,{passwordSalt:salt,passwordHash:passwordHash_(password,salt),mustChangePassword:true,updatedAt:new Date().toISOString()});return {ok:true,schoolName:byId_("schools",s.schoolId).name,username:t.username,temporaryPassword:password};});}
function validRoles_(v){const a=Array.isArray(v)?v:String(v||"").split(",");return HEMSTT.modules.filter(r=>a.indexOf(r)>=0);}

function dashboardData_(s){if(s.role==="super")throw new Error("Pilih sekolah dahulu.");const rec=rows_("records").filter(r=>r.schoolId===s.schoolId),teachers=rows_("teachers").filter(r=>r.schoolId===s.schoolId&&truthy_(r.active)),counts={};HEMSTT.modules.forEach(m=>counts[m]=rec.filter(r=>r.module===m).length);return {ok:true,teacherCount:teachers.length,recordCount:rec.length,moduleCounts:counts,teachers:s.role==="school"?teachers.map(publicTeacher_):[]};}
function recordList_(s,d){const module=clean_(d.module,40);if(!HEMSTT.modules.includes(module))throw new Error("Modul tidak sah.");if(s.role==="teacher"&&!teacherRoles_(s).includes(module))throw new Error("Modul ini tidak diberikan kepada akaun anda.");let list=rows_("records").filter(r=>r.schoolId===s.schoolId&&r.module===module);if(s.role==="teacher")list=list.filter(r=>r.teacherId===s.adminId);const teachers=rows_("teachers");return {ok:true,records:list.sort((a,b)=>String(b.recordDate+b.createdAt).localeCompare(String(a.recordDate+a.createdAt))).slice(0,200).map(r=>Object.assign(publicRecord_(r),{teacherName:(teachers.find(t=>t.id===r.teacherId)||{}).fullName||""}))};}
function saveRecord_(s,d){if(s.role!=="teacher")throw new Error("Rekod harian perlu diisi melalui akaun guru.");const module=clean_(d.module,40);if(!teacherRoles_(s).includes(module))throw new Error("Tugasan ini tidak diberikan kepada anda.");const date=clean_(d.recordDate,10),title=clean_(d.title,140),summary=clean_(d.summary,1200);if(!/^\d{4}-\d{2}-\d{2}$/.test(date)||!title||!summary)throw new Error("Tarikh, tajuk dan catatan diperlukan.");const now=new Date().toISOString(),id=Utilities.getUuid();append_("records",{id:id,schoolId:s.schoolId,teacherId:s.adminId,module:module,recordDate:date,sessionName:clean_(d.sessionName,60),status:d.status==="action"?"action":"complete",title:title,summary:summary,numericValue:clean_(d.numericValue,40),details:clean_(d.details,1500),createdAt:now,updatedAt:now});audit_(s,"record_created",s.schoolId,module+" "+date);return {ok:true,record:publicRecord_(byId_("records",id))};}
function teacherRoles_(s){const t=byId_("teachers",s.adminId);if(!t)throw new Error("Akaun guru tidak dijumpai.");return validRoles_(t.roles);}

function changePassword_(s,d){if(!["school","teacher"].includes(s.role))throw new Error("Tindakan tidak dibenarkan.");return withLock_(()=>{const name=s.role==="school"?"admins":"teachers",u=byId_(name,s.adminId);if(!u||!secureEqual_(passwordHash_(clean_(d.currentPassword,150),u.passwordSalt),u.passwordHash))throw new Error("Kata laluan semasa tidak betul.");const next=clean_(d.newPassword,150);if(next.length<8)throw new Error("Kata laluan baharu mestilah sekurang-kurangnya 8 aksara.");const salt=random_(32);updateById_(name,u.id,{passwordSalt:salt,passwordHash:passwordHash_(next,salt),mustChangePassword:false,updatedAt:new Date().toISOString()});return {ok:true};});}
function schoolList_(){const admins=rows_("admins"),teachers=rows_("teachers");return rows_("schools").map(s=>{const a=admins.find(r=>r.schoolId===s.id)||{};return Object.assign(publicSchool_(s),{adminName:a.fullName||"",adminUsername:a.username||"",mustChangePassword:truthy_(a.mustChangePassword),teacherCount:teachers.filter(t=>t.schoolId===s.id&&truthy_(t.active)).length});}).sort((a,b)=>String(b.createdAt).localeCompare(String(a.createdAt)));}
function publicSchool_(r){return pick_(r,["id","code","name","district","state","address","logoUrl","sessionMode","morningName","afternoonName","status","createdAt","updatedAt"]);}function publicAdmin_(r){const v=pick_(r,["id","fullName","username"]);v.mustChangePassword=truthy_(r.mustChangePassword);return v;}function publicTeacher_(r){const v=pick_(r,["id","fullName","staffId","username","sessionName","className","createdAt","updatedAt"]);v.roles=validRoles_(r.roles);v.active=truthy_(r.active);v.mustChangePassword=truthy_(r.mustChangePassword);return v;}function publicRecord_(r){return pick_(r,["id","module","recordDate","sessionName","status","title","summary","numericValue","details","createdAt","updatedAt"]);}

function createSession_(role,adminId,schoolId){const token=random_(80),now=Date.now();append_("sessions",{id:Utilities.getUuid(),tokenHash:digest_(token),role:role,adminId:adminId,schoolId:schoolId,expiresAt:now+HEMSTT.sessionHours*3600000,createdAt:new Date(now).toISOString()});return token;}
function requireSession_(token){const hash=digest_(clean_(token,160)),r=rows_("sessions").find(x=>secureEqual_(x.tokenHash,hash)&&Number(x.expiresAt)>Date.now());if(!r)throw new Error("Sesi tidak sah. Sila log masuk semula.");return {id:r.id,role:r.role,adminId:r.adminId,schoolId:r.schoolId};}
function requireSuper_(s){if(!s||s.role!=="super")throw new Error("Tindakan ini hanya untuk pentadbir utama.");return s;}function requireSchool_(s){if(!s||s.role!=="school")throw new Error("Tindakan ini hanya untuk pentadbir sekolah.");return s;}
function saveLogo_(school,data){const m=String(data).match(/^data:(image\/(?:png|jpeg));base64,(.+)$/);if(!m)throw new Error("Gunakan logo PNG atau JPG yang sah.");const bytes=Utilities.base64Decode(m[2]);if(bytes.length>2000000)throw new Error("Logo mestilah di bawah 2 MB.");const ext=m[1]==="image/png"?"png":"jpg",f=DriveApp.getFolderById(property_("LOGO_FOLDER_ID")).createFile(Utilities.newBlob(bytes,m[1],school.code+"-logo."+ext));f.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);return "https://drive.google.com/uc?export=view&id="+f.getId();}
function audit_(s,a,schoolId,details){append_("audit",{id:Utilities.getUuid(),actorRole:s.role,actorAdminId:s.adminId||"",schoolId:schoolId||"",action:a,details:clean_(details,500),createdAt:new Date().toISOString()});}
function throttle_(key){const c=CacheService.getScriptCache(),k="login:"+digest_(key).slice(0,30),n=Number(c.get(k)||0)+1;if(n>12)throw new Error("Terlalu banyak cubaan. Sila tunggu beberapa minit.");c.put(k,String(n),300);}function property_(n){const v=PropertiesService.getScriptProperties().getProperty(n);if(!v)throw new Error("Tetapan pelayan "+n+" belum disediakan.");return v;}function passwordHash_(p,s){return hmac_(s+"|"+p,property_("PASSWORD_PEPPER"));}function digest_(v){return Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(v),Utilities.Charset.UTF_8));}function hmac_(v,k){return Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(String(v),String(k),Utilities.Charset.UTF_8));}function secureEqual_(a,b){a=String(a||"");b=String(b||"");if(a.length!==b.length)return false;let d=0;for(let i=0;i<a.length;i++)d|=a.charCodeAt(i)^b.charCodeAt(i);return d===0;}function random_(n){let v="";while(v.length<n)v+=Utilities.getUuid().replace(/-/g,"");return v.slice(0,n);}function truthy_(v){return v===true||String(v).toLowerCase()==="true"||Number(v)===1;}function clean_(v,n){return String(v==null?"":v).trim().slice(0,n||180);}function safeError_(x){console.error(x&&x.stack?x.stack:x);return x&&x.message?x.message:"Ralat pelayan berlaku.";}function output_(d){return ContentService.createTextOutput(JSON.stringify(d)).setMimeType(ContentService.MimeType.JSON);}function withLock_(cb){const l=LockService.getScriptLock();l.waitLock(20000);try{return cb();}finally{l.releaseLock();}}function pick_(s,ks){const o={};ks.forEach(k=>o[k]=s[k]==null?"":s[k]);return o;}
function db_(){if(!DB_CACHE_)DB_CACHE_=SpreadsheetApp.openById(property_("DATABASE_SPREADSHEET_ID"));return DB_CACHE_;}function ensureSheet_(ss,n,h){let sh=ss.getSheetByName(n);if(!sh)sh=ss.insertSheet(n);const cur=sh.getLastColumn()?sh.getRange(1,1,1,Math.max(sh.getLastColumn(),h.length)).getValues()[0]:[];if(sh.getLastRow()===0||h.some((x,i)=>cur[i]!==x)){sh.getRange(1,1,1,h.length).setValues([h]).setFontWeight("bold").setBackground("#0b63d9").setFontColor("#fff");sh.setFrozenRows(1);}return sh;}function sheet_(n){if(!SHEET_CACHE_[n])SHEET_CACHE_[n]=ensureSheet_(db_(),n,HEMSTT.sheets[n]);return SHEET_CACHE_[n];}function rowsFrom_(sh,n){const vs=sh.getDataRange().getValues(),h=HEMSTT.sheets[n];if(vs.length<2)return [];return vs.slice(1).filter(r=>r.some(c=>c!=="")).map(r=>{const o={};h.forEach((x,i)=>o[x]=r[i]);return o;});}function rows_(n){return rowsFrom_(sheet_(n),n);}function appendTo_(sh,n,o){sh.appendRow(HEMSTT.sheets[n].map(h=>o[h]==null?"":o[h]));}function append_(n,o){appendTo_(sheet_(n),n,o);}function byId_(n,id){return rows_(n).find(r=>String(r.id)===String(id));}function updateById_(n,id,p){const sh=sheet_(n),v=sh.getDataRange().getValues(),h=HEMSTT.sheets[n],ix=h.indexOf("id");for(let i=1;i<v.length;i++){if(String(v[i][ix])!==String(id))continue;Object.keys(p).forEach(k=>{const j=h.indexOf(k);if(j>=0)v[i][j]=p[k];});sh.getRange(i+1,1,1,h.length).setValues([v[i].slice(0,h.length)]);return;}throw new Error("Rekod tidak dijumpai.");}function deleteById_(n,id){const sh=sheet_(n),v=sh.getDataRange().getValues(),ix=HEMSTT.sheets[n].indexOf("id");for(let i=v.length-1;i>=1;i--)if(String(v[i][ix])===String(id))sh.deleteRow(i+1);}
